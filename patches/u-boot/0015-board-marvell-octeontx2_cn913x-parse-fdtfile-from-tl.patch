From 0dacda8e7c9e1433f872114995bcdaa60cdff070 Mon Sep 17 00:00:00 2001
From: Josua Mayer <josua@solid-run.com>
Date: Sun, 26 Jan 2025 16:14:58 +0100
Subject: [PATCH 15/15] board: marvell: octeontx2_cn913x: parse fdtfile from
 tlv eeprom

Signed-off-by: Josua Mayer <josua@solid-run.com>
---
 board/Marvell/octeontx2_cn913x/board.c | 117 +++++++++++++++++++++++++
 1 file changed, 117 insertions(+)

diff --git a/board/Marvell/octeontx2_cn913x/board.c b/board/Marvell/octeontx2_cn913x/board.c
index 635899efe3a..9e117436e5a 100644
--- a/board/Marvell/octeontx2_cn913x/board.c
+++ b/board/Marvell/octeontx2_cn913x/board.c
@@ -14,6 +14,7 @@
 #include <asm/arch/cpu.h>
 #include <asm/arch/soc.h>
 #include <power/regulator.h>
+#include <tlv_eeprom.h>
 #ifdef CONFIG_BOARD_CONFIG_EEPROM
 #include <mvebu/cfg_eeprom.h>
 #endif
@@ -116,9 +117,125 @@ static int init_bootcmd_console(void)
 	return ret;
 }
 #endif
+
+#define to_entry(p) ((struct tlvinfo_tlv *)p)
+
+static bool get_fdtfile_from_tlv_eeprom(u8 *buffer, size_t length) {
+	struct tlvinfo_header *hdr;
+	struct tlvinfo_tlv *entry;
+	int index;
+	char cpu[5] = {0};
+	char carrier[12] = {0};
+	static u8 eeprom[TLV_INFO_MAX_LEN];
+	char sku[257];
+	bool ret = true;
+
+	for(int i = 0; i < 2;i++) {
+		// read eeprom
+		if (read_tlvinfo_tlv_eeprom(eeprom, &hdr, &entry, i)) {
+			pr_info("%s: failed to read eeprom %d\n", __func__, i);
+			continue;
+		}
+
+		// read sku
+		if (!tlvinfo_find_tlv(eeprom, TLV_CODE_PART_NUMBER, &index)) {
+			pr_warn("%s: could not find sku in eeprom\n", __func__);
+			continue;
+		} else {
+			entry = to_entry(&eeprom[index]);
+			memcpy(sku, entry->value, entry->length);
+			sku[entry->length] = '\0';
+		}
+		pr_debug("%s: read sku %s\n", __func__, sku);
+
+		if(memcmp(&sku[0], "VT", 2) == 0) {
+			// parse sku - processor or carrier indicated at index 2-6
+			if(memcmp(&sku[2], "CFCB", 4) == 0) {
+				// AIR-300 Carrier
+				strcpy(carrier, "vt-air-300");
+
+				// #CPs on carrier indicated by next 4 chars
+				memcpy(cpu, &sku[2+4], 4);
+			} else {
+				pr_err("%s: did not recognise SKU %s!\n", __func__, sku);
+			}
+		} else {
+			// parse sku - processor or carrier indicated at index 2-6
+			if(memcmp(&sku[2], "S9130", 4) == 0) {
+				// SoM - S913x
+			} else if(memcmp(&sku[2], "CFCB", 4) == 0) {
+				// Clearfog Base
+				strcpy(carrier, "cf-base");
+
+				// Carrier has no extra CPs
+				strcpy(cpu, "9130");
+			} else if(memcmp(&sku[2], "CFCP", 4) == 0) {
+				// Clearfog Pro
+				strcpy(carrier, "cf-pro");
+
+				// Carrier has no extra CPs
+				strcpy(cpu, "9130");
+			} else if(memcmp(&sku[2], "CFSW", 4) == 0) {
+				// SolidWan SOM S9131
+				strcpy(carrier, "cf-solidwan");
+
+				// Carrier has 1 extra CPs
+				strcpy(cpu, "9131");
+			} else if(memcmp(&sku[2], "C", 1) == 0) {
+				// COM-Express 7 - C9130 / C9131 / C9132 ...
+				strcpy(carrier, "cex7");
+
+				// COM can have additional CPs indicated in next 4 chars
+				memcpy(cpu, &sku[2+1], 4);
+			} else {
+				pr_err("%s: did not recognise SKU %s!\n", __func__, sku);
+			}
+		}
+	}
+
+	if(!cpu[0]) {
+		pr_err("%s: could not identify SoC, defaulting to %s!\n", __func__, "CN9130");
+		strcpy(cpu, "9130");
+		ret = false;
+	}
+
+	if(!carrier[0]) {
+		pr_err("%s: could not identify carrier, defaulting to %s!\n", __func__, "Clearfog Pro");
+		strcpy(carrier, "cf-pro");
+		ret = false;
+	}
+
+	// assemble fdtfile
+	if(snprintf(buffer, length, "marvell/cn%s-%s.dtb", cpu, carrier) >= length) {
+		pr_err("%s: fdtfile buffer too small, result truncated!\n", __func__);
+		ret = false;
+	}
+
+	return ret;
+}
+
 u64 fdt_get_board_info(void);
 int board_late_init(void)
 {
+	char fdtfile[32] = {0};
+	const char *env_fdtfile;
+
+	// identify device
+	if (get_fdtfile_from_tlv_eeprom(fdtfile, sizeof(fdtfile))) {
+		// compare existing fdtfile variable
+		env_fdtfile = env_get("fdtfile");
+		if (env_fdtfile && strcmp(env_fdtfile, fdtfile))
+			pr_info("Overriding fdtfile from TLV EEPROM: \"%s\" -> \"%s\"\n", env_fdtfile, fdtfile);
+
+		// update fdtfile variable
+		env_set("fdtfile", fdtfile);
+	}
+
+	if (!CONFIG_IS_ENABLED(ID_EEPROM)) {
+		/* read MAC addresses and save in environment */
+		mac_read_from_eeprom();
+	}
+
 #if CONFIG_IS_ENABLED(OCTEONTX_SERIAL_BOOTCMD)
 	if (init_bootcmd_console())
 		printf("Failed to init bootcmd input\n");
-- 
